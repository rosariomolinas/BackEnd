# Puerto donde escucha la API
PORT=8080

# Base de datos. Opción 1: MongoDB Atlas (mongodb+srv://<db_user>:<db_password>@<mongo_url>)
mongo_url=cluster0.xxxxx.mongodb.net/robiotics?retryWrites=true&w=majority
db_user=usuario
db_password=cambiar
# Opción 2: una URI completa, por ejemplo una base local. Si está definida, tiene prioridad.
# MONGO_URI=mongodb://localhost:27017/robiotics

# Firma de los JWT de sesión: usar un valor largo y aleatorio (obligatorio en producción)
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
# Duración de la sesión
JWT_EXPIRES_IN=8h

# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:3000

# Costos y tiempos por tipo de muestra en una intervención
tejido_costo=100
sangre_costo=50
tomo3d_costo=200
tejido_tiempo=10
sangre_tiempo=5
tomo3d_tiempo=20
